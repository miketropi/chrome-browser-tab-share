APP_DOMAIN=share.example.com
ALLOWED_EXTENSION_IDS=replace_with_extension_id
HOST_ACCESS_KEY=replace_with_at_least_32_random_characters
TURN_HOST=turn.example.com
TURN_SHARED_SECRET=replace_with_at_least_32_random_characters
TURN_LISTEN_IP=203.0.113.10
TURN_TLS_PORT=5349
TURN_CERT_PATH=/etc/letsencrypt/live/turn.example.com/fullchain.pem
TURN_KEY_PATH=/etc/letsencrypt/live/turn.example.com/privkey.pem
MAX_GUESTS=4
MAX_SESSIONS=10
SESSION_TTL_SECONDS=7200
INVITE_TTL_SECONDS=600
